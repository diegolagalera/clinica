# =============================================
#  CUSPIA-ERP — Production Environment Variables
#  Copy this file and fill in your values:
#    cp .env.prod.example .env.prod
# =============================================

# ---- Domain ----
DOMAIN=cuspia.com
FRONTEND_URL=https://app.cuspia.com
VITE_API_URL=https://api.cuspia.com/api/v1

# ---- Database ----
DB_USER=cuspia
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- Hetzner Object Storage (S3-compatible) ----
S3_ACCESS_KEY=YOUR_HETZNER_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_HETZNER_S3_SECRET_KEY
S3_LOCATION=nbg1

# ---- JWT Secrets (min 32 chars, use: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@cuspia.com
SUPPORT_EMAIL=soporte@cuspia.com

# ---- AI / OpenAI ----
AI_SERVICE_URL=
AI_API_KEY=
OPENAI_API_KEY=

# ---- Logging ----
LOG_LEVEL=info

# ---- SignNow E-Signature ----
SIGNNOW_API_KEY=
SIGNNOW_API_URL=https://api.signnow.com
